# ─── Custom 404 ─────────────────────────────────────────────────────────
ErrorDocument 404 /404.html

# ─── Force HTTPS ────────────────────────────────────────────────────────
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ─── Legacy pre-SPA pages → SPA routes ──────────────────────────────────
# The old static site (about.html etc.) was replaced by the hash-routed SPA;
# without redirects, old inbound links and crawlers still landed on the
# outdated copies. NE keeps the # literal in the Location header.
RewriteRule ^about\.html$ /#/about [R=301,L,NE]
RewriteRule ^contact\.html$ /#/contact [R=301,L,NE]
RewriteRule ^portfolio\.html$ /#/archive [R=301,L,NE]
RewriteRule ^prototype-viewfinder\.html$ / [R=301,L]
RewriteRule ^redesign(/.*)?$ / [R=301,L]

# ─── Compression ────────────────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/xml application/xml application/rss+xml image/svg+xml
</IfModule>

# ─── Long-term caching for hashed/static assets ─────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# ─── Correct MIME types for modern image formats ────────────────────────
<IfModule mod_mime.c>
  AddType image/webp .webp
  AddType image/avif .avif
</IfModule>
